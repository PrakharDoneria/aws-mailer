{
  "name": "mailforge-infrastructure",
  "version": "0.1.0",
  "description": "AWS CDK infrastructure for MailForge",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "bootstrap": "cdk bootstrap",
    "deploy": "cdk deploy --all",
    "deploy:dev": "cdk deploy --all -c environment=dev",
    "deploy:prod": "cdk deploy --all -c environment=prod",
    "destroy": "cdk destroy --all",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "logs": "cdk logs",
    "clean": "rm -rf dist cdk.out"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.115.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@mailforge/shared": "^0.1.0",
    "aws-cdk-lib": "^2.115.0",
    "constructs": "^10.3.0"
  }
}
